+  ${TINYXML2_PATCH_COMMAND}
   EXCLUDE_FROM_ALL
 )
-target_compile_options(tinyxml2 PRIVATE ${MUJOCO_MACOS_COMPILE_OPTIONS})
+target_compile_options(tinyxml2 PRIVATE ${MUJOCO_MACOS_COMPILE_OPTIONS} -fvisibility=hidden -fvisibility-inlines-hidden)
+target_compile_definitions(tinyxml2 PRIVATE TINYXML2_STATIC_HIDDEN)
 target_link_options(tinyxml2 PRIVATE ${MUJOCO_MACOS_LINK_OPTIONS})
 
 # update cmake_minimum_required version for compatibility with newer version of cmake
