 set(tinyxml2_BUILD_TESTING OFF)
+# Patch tinyxml2 to support hiding symbols when built as static dependency
+set(TINYXML2_PATCH_COMMAND
+  git apply --reject --whitespace=fix ${mujoco_SOURCE_DIR}/cmake/tinyxml2-hide-symbols.patch
+)
 findorfetch(
   USE_SYSTEM_PACKAGE
   OFF
@@ -172,9 +181,12 @@ findorfetch(
   ${MUJOCO_DEP_VERSION_tinyxml2}
   TARGETS
