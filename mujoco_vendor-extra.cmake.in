@PACKAGE_INIT@

set(_mujoco_vendor_root "${CMAKE_CURRENT_LIST_DIR}/../../..")
set(mujoco_vendor_INCLUDE_DIRS "${_mujoco_vendor_root}/opt/@PROJECT_NAME@/include")
set(mujoco_vendor_LIBRARY_DIRS "${_mujoco_vendor_root}/opt/@PROJECT_NAME@/lib")

if(NOT EXISTS "${mujoco_vendor_INCLUDE_DIRS}")
  message(FATAL_ERROR "Directory ${mujoco_vendor_INCLUDE_DIRS} referenced by variable mujoco_vendor_INCLUDE_DIRS does not exist.")
endif()

include("${CMAKE_CURRENT_LIST_DIR}/mujoco_vendorTargets.cmake")

set(mujoco_vendor_LIBRARIES mujoco::mujoco)